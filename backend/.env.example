APP_NAME=SignLang API
ENVIRONMENT=development
DEBUG=true
# IMPORTANTE: SECRET_KEY cifra los rostros registrados y firma las sesiones.
# La base incluida se cifró con la clave por defecto del código, así que déjala
# comentada. Si la cambias, habrá que volver a registrar los rostros e iniciar sesión.
# SECRET_KEY=pon-aqui-una-clave-larga-y-aleatoria
DATABASE_URL=sqlite:///./data/app.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SENTENCE_AI_ENABLED=true
SENTENCE_AI_USE_GPU=true

# Mantén la misma SECRET_KEY y DATABASE_URL en todos los equipos/instancias.
# El registro facial cifrado no se podrá descifrar si cambias SECRET_KEY.

# Reconocimiento con ambas manos (prueba la mano espejada y decide por votación)
HAND_MIRROR_AUTO=true
HAND_ORIENTATION_WINDOW=24
HAND_ORIENTATION_SWITCH=0.75
